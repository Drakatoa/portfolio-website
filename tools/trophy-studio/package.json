    "@pixiv/three-vrm": "^3.5.5",
    "@pixiv/three-vrm-animation": "^3.5.5",
    "meshoptimizer": "^1.3.0",
    "playwright-core": "^1.63.0",
    "pngjs": "^7.0.0",
    "potrace": "^2.1.8",
    "three": "^0.186.1",
    "vite": "^7.3.6"
  }
