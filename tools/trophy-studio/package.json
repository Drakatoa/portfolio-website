{
  "name": "trophy-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Authoring and review workspace for the portfolio trophy models. Not part of the portfolio bundle.",
  "scripts": {
    "dev": "vite --port 5187 --strictPort",
    "trace": "node scripts/trace-logos.mjs",
    "bake": "node scripts/bake.mjs",
